rules_version = '2';

// Une liste par famille. On rejoint une famille avec son code, et seulement
// comme ça : aucune famille ni aucun code ne se crée depuis l'application.
//
//   codes/<CODE>                 { famille }        créé par l'administrateur
//   familles/<id>                { nom, code }      créé par l'administrateur
//   familles/<id>/produits/<id>  la liste et l'historique de la famille
//   familles/<id>/photos/<id>    { image }          photo en grand
//   membres/<uid>                { famille, pseudo, code, creeLe }
//
// La fiche membre n'est acceptée que si le code qu'elle porte mène bien à la
// famille demandée : impossible de s'inviter chez quelqu'un sans son code.

service cloud.firestore {
  match /databases/{base}/documents {

    function connecte() {
      return request.auth != null;
    }

    function deLaFamille(f) {
      return connecte()
        && exists(/databases/$(base)/documents/membres/$(request.auth.uid))
        && get(/databases/$(base)/documents/membres/$(request.auth.uid)).data.famille == f;
    }

    // Lisible un par un, à condition de connaître le code ; jamais listé
    match /codes/{code} {
      allow get: if true;
      allow list, write: if false;
    }

    match /membres/{uid} {
      allow get: if connecte() && request.auth.uid == uid;
      allow create: if connecte() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['famille', 'pseudo', 'code', 'creeLe'])
        && request.resource.data.code is string
        && exists(/databases/$(base)/documents/codes/$(request.resource.data.code))
        && get(/databases/$(base)/documents/codes/$(request.resource.data.code)).data.famille
           == request.resource.data.famille;
      allow list, update, delete: if false;
    }

    match /familles/{f} {
      allow get: if deLaFamille(f);
      allow list, write: if false;

      match /produits/{id} {
        allow read, write: if deLaFamille(f);
      }

      match /photos/{id} {
        allow read, delete: if deLaFamille(f);
        allow create, update: if deLaFamille(f)
          && request.resource.data.image is string
          && request.resource.data.image.size() < 900000;
      }
    }
  }
}
